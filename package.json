{
  "name": "supabase-mobile-pro",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "mobile-pro": "./scripts/mobile-cli.mjs"
  },
  "files": [
    "packages/mobile-core",
    "scripts/consumer.mjs",
    "scripts/mobile-cli.mjs",
    "scripts/mobile-runtime.mjs",
    "scripts/native-plugins.mjs"
  ],
  "scripts": {
    "modules:init": "git submodule update --init --recursive",
    "modules:pull": "node scripts/pull-modules.mjs",
    "modules:status": "git submodule status --recursive",
    "modules:install": "pnpm run modules:dispatch install",
    "modules:dispatch": "node scripts/modules.mjs",
    "modules:check": "pnpm run modules:dispatch typecheck",
    "modules:build": "pnpm run modules:dispatch build",
    "dev:h5:driver": "pnpm run modules:dispatch dev:h5 driver",
    "dev:h5:shipper": "pnpm run modules:dispatch dev:h5 shipper",
    "dev:h5:smis": "pnpm run modules:dispatch dev:h5 smis",
    "dev:mp-weixin": "pnpm run modules:dispatch dev:mp-weixin",
    "build:h5": "pnpm run modules:dispatch build:h5",
    "build:mp-weixin": "pnpm run modules:dispatch build:mp-weixin",
    "android:sync": "node scripts/android.mjs sync",
    "build:android": "node scripts/android.mjs build",
    "font:css": "node scripts/build-ui-font-css.mjs",
    "icons:build": "node scripts/build-mobile-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/cli": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/geolocation": "8.2.5",
    "@capacitor/synapse": "1.0.4",
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-app": "3.0.0-alpha-1000920260909822",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-1000920260909822",
    "@dcloudio/uni-cloud": "3.0.0-alpha-1000920260909822",
    "@dcloudio/uni-components": "3.0.0-alpha-1000920260909822",
    "@dcloudio/uni-console": "3.0.0-alpha-1000920260909822",
    "@dcloudio/uni-h5": "3.0.0-alpha-1000920260909822",
    "@dcloudio/uni-i18n": "3.0.0-alpha-1000920260909822",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-1000920260909822",
    "@dcloudio/uni-push": "3.0.0-alpha-1000920260909822",
    "@dcloudio/uni-shared": "3.0.0-alpha-1000920260909822",
    "@dcloudio/uni-stat": "3.0.0-alpha-1000920260909822",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-1000920260909822",
    "@vue/compiler-sfc": "3.5.45",
    "@vue/tsconfig": "0.9.1",
    "@wot-ui/ui": "2.4.0",
    "pinia": "3.0.4",
    "playwright": "1.65.1",
    "sass": "1.108.2",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  },
  "devDependencies": {
    "bootstrap-icons": "1.13.2",
    "subset-font": "2.9.0"
  }
}
